{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "MetricRange": {
      "anyOf": [
        {
          "properties": {
            "p10": {
              "type": "number"
            },
            "p50": {
              "type": "number"
            },
            "p90": {
              "type": "number"
            }
          }
        },
        {
          "properties": {
            "p10": {
              "type": "null"
            },
            "p50": {
              "type": "null"
            },
            "p90": {
              "type": "null"
            }
          }
        }
      ],
      "description": "P10/P50/P90 of a metric. All three null = unknown (a required input is missing; \u00a72 rule 2: unknown \u2260 zero).",
      "properties": {
        "p10": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P10"
        },
        "p50": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P50"
        },
        "p90": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P90"
        },
        "unit": {
          "enum": [
            "usd",
            "hours",
            "kg_co2e",
            "months",
            "patients",
            "percent",
            "kits",
            "count"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "p10",
        "p50",
        "p90",
        "unit"
      ],
      "title": "MetricRange",
      "type": "object"
    }
  },
  "description": "Supply display subset; extra producer fields are ignored (v4, A8).",
  "properties": {
    "kits_needed": {
      "$ref": "#/$defs/MetricRange"
    },
    "kits_produced": {
      "$ref": "#/$defs/MetricRange"
    },
    "kits_wasted": {
      "$ref": "#/$defs/MetricRange"
    },
    "waste_share": {
      "$ref": "#/$defs/MetricRange"
    },
    "shipments": {
      "$ref": "#/$defs/MetricRange"
    },
    "stockout_probability": {
      "maximum": 1,
      "minimum": 0,
      "title": "Stockout Probability",
      "type": "number"
    }
  },
  "required": [
    "kits_needed",
    "kits_produced",
    "kits_wasted",
    "waste_share",
    "shipments",
    "stockout_probability"
  ],
  "title": "SupplyView",
  "type": "object"
}
