{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "MetricRange": {
      "anyOf": [
        {
          "properties": {
            "p10": {
              "type": "number"
            },
            "p50": {
              "type": "number"
            },
            "p90": {
              "type": "number"
            }
          }
        },
        {
          "properties": {
            "p10": {
              "type": "null"
            },
            "p50": {
              "type": "null"
            },
            "p90": {
              "type": "null"
            }
          }
        }
      ],
      "description": "P10/P50/P90 of a metric. All three null = unknown (a required input is missing; \u00a72 rule 2: unknown \u2260 zero).",
      "properties": {
        "p10": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P10"
        },
        "p50": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P50"
        },
        "p90": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P90"
        },
        "unit": {
          "enum": [
            "usd",
            "hours",
            "kg_co2e",
            "months",
            "patients",
            "percent",
            "kits",
            "count"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "p10",
        "p50",
        "p90",
        "unit"
      ],
      "title": "MetricRange",
      "type": "object"
    }
  },
  "properties": {
    "intervention_id": {
      "title": "Intervention Id",
      "type": "string"
    },
    "method": {
      "const": "diff_in_diff",
      "title": "Method",
      "type": "string"
    },
    "effect": {
      "$ref": "#/$defs/MetricRange"
    },
    "treated_change": {
      "title": "Treated Change",
      "type": "number"
    },
    "control_change": {
      "title": "Control Change",
      "type": "number"
    },
    "verdict": {
      "enum": [
        "likely_worked",
        "inconclusive",
        "likely_coincidence",
        "no_effect"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "explanation": {
      "title": "Explanation",
      "type": "string"
    }
  },
  "required": [
    "intervention_id",
    "method",
    "effect",
    "treated_change",
    "control_change",
    "verdict",
    "explanation"
  ],
  "title": "EffectEstimate",
  "type": "object"
}
