{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "MetricRange": {
      "properties": {
        "p10": {
          "title": "P10",
          "type": "number"
        },
        "p50": {
          "title": "P50",
          "type": "number"
        },
        "p90": {
          "title": "P90",
          "type": "number"
        },
        "unit": {
          "enum": [
            "usd",
            "hours",
            "kg_co2e",
            "months",
            "patients",
            "percent",
            "kits"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "p10",
        "p50",
        "p90",
        "unit"
      ],
      "title": "MetricRange",
      "type": "object"
    }
  },
  "properties": {
    "intervention_id": {
      "title": "Intervention Id",
      "type": "string"
    },
    "method": {
      "const": "diff_in_diff",
      "title": "Method",
      "type": "string"
    },
    "effect": {
      "$ref": "#/$defs/MetricRange"
    },
    "treated_change": {
      "title": "Treated Change",
      "type": "number"
    },
    "control_change": {
      "title": "Control Change",
      "type": "number"
    },
    "verdict": {
      "enum": [
        "likely_worked",
        "inconclusive",
        "likely_coincidence",
        "no_effect"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "explanation": {
      "title": "Explanation",
      "type": "string"
    }
  },
  "required": [
    "intervention_id",
    "method",
    "effect",
    "treated_change",
    "control_change",
    "verdict",
    "explanation"
  ],
  "title": "EffectEstimate",
  "type": "object"
}
