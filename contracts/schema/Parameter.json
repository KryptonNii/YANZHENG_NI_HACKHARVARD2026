{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "value_low": {
      "title": "Value Low",
      "type": "number"
    },
    "value_mid": {
      "title": "Value Mid",
      "type": "number"
    },
    "value_high": {
      "title": "Value High",
      "type": "number"
    },
    "unit": {
      "title": "Unit",
      "type": "string"
    },
    "source_title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Title"
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "source_year": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Year"
    },
    "assumption": {
      "default": false,
      "title": "Assumption",
      "type": "boolean"
    },
    "rationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "region": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Region"
    }
  },
  "required": [
    "id",
    "label",
    "value_low",
    "value_mid",
    "value_high",
    "unit"
  ],
  "title": "Parameter",
  "type": "object"
}
