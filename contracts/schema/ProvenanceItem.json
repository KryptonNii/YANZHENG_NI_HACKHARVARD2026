    "formula_id": {
      "title": "Formula Id",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "inputs": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      },
