{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "signer": {
      "title": "Signer",
      "type": "string"
    },
    "role": {
      "enum": [
        "author",
        "reviewer",
        "qa",
        "admin",
        "viewer"
      ],
      "title": "Role",
      "type": "string"
    },
    "signer_name": {
      "title": "Signer Name",
      "type": "string"
    },
    "meaning": {
      "enum": [
        "authored",
        "reviewed",
        "approved",
        "executed",
        "verified"
      ],
      "title": "Meaning",
      "type": "string"
    },
    "signed_at": {
      "format": "date-time",
      "title": "Signed At",
      "type": "string"
    },
    "record_type": {
      "title": "Record Type",
      "type": "string"
    },
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "record_hash": {
      "title": "Record Hash",
      "type": "string"
    }
  },
  "required": [
    "id",
    "signer",
    "role",
    "signer_name",
    "meaning",
    "signed_at",
    "record_type",
    "record_id",
    "record_hash"
  ],
  "title": "Signature",
  "type": "object"
}
