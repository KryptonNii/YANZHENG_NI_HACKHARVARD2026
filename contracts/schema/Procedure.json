{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "code": {
      "title": "Code",
      "type": "string"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "endpoint_role": {
      "default": "unknown",
      "enum": [
        "supports_primary",
        "supports_secondary",
        "not_linked",
        "unknown"
      ],
      "title": "Endpoint Role",
      "type": "string"
    },
    "endpoint_note": {
      "default": "",
      "title": "Endpoint Note",
      "type": "string"
    },
    "link_basis": {
      "default": "unmatched",
      "enum": [
        "outcome_title",
        "human",
        "unmatched"
      ],
      "title": "Link Basis",
      "type": "string"
    },
    "site_minutes": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Site Minutes"
    },
    "ships_sample": {
      "default": false,
      "title": "Ships Sample",
      "type": "boolean"
    },
    "sample_temp": {
      "anyOf": [
        {
          "enum": [
            "ambient",
            "refrigerated",
            "frozen_-20",
            "frozen_-80"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sample Temp"
    }
  },
  "required": [
    "code",
    "label"
  ],
  "title": "Procedure",
  "type": "object"
}
