# TrialPilot behind Caddy (automatic HTTPS). Install Caddy on the host, then:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
# Set TP_DOMAIN in /etc/default/caddy (e.g. TP_DOMAIN=trialpilot.example.org) or replace it below.
# The app container listens on 127.0.0.1:8000 only (docker-compose.yml); Caddy is the only public port.

{$TP_DOMAIN} {
	encode zstd gzip

	# Optional: the demo identity is a plain header (X-User/X-Role), so lock a public demo behind a
	# password. Generate the hash with `caddy hash-password` and uncomment:
	# basic_auth {
	# 	judge $2a$14$REPLACE_WITH_HASH
	# }

	reverse_proxy 127.0.0.1:8000 {
		# Server-Sent Events (/api/ops/{trial}/stream): forward every chunk immediately.
		flush_interval -1
		health_uri /api/health
		health_interval 30s
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		-Server
	}

	log {
		output file /var/log/caddy/trialpilot.log
		format json
	}
}
