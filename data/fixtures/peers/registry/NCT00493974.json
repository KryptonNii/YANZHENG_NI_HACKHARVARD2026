  "outcomesModule": {
   "primaryOutcomes": [
    {
     "measure": "Length of Hospital Stay",
     "description": "Admission will begin at the time the subject has been admitted to an inpatient service. Length of Stay (LOS) will be recorded in days. The LOS will be based on the number of days spent in an acute medical ward or in the ICU. Subjects that are admitted and discharged in the same 24 hour period will be recorded as a LOS of 1 day, as will subjects discharged in the ensuing 24 hour period. LOS's greater than 10 days will be truncated to 10 days.",
     "timeFrame": "Measured at Day 30"
    }
   ],
   "secondaryOutcomes": [
    {
     "measure": "Change in FEV1% Predicted",
     "description": "Change in Post-bronchodilator FEV1% predicted comparing data at 30 day visit with baseline.",
     "timeFrame": "Measured at Baseline and Day 30"
    },
    {
     "measure": "Change in FEV1/FEV6 Levels",
     "description": "Change in Post-bronchodilator FEV1/FEV6 ratio comparing data at discharge visit with baseline.",
     "timeFrame": "from baseline to day of discharge"
    },
    {
     "measure": "Treatment Failure",
     "description": "Treatment failure is defined as death, intubation, readmission to a hospital for COPD, urgent visit to an outpatient or ED provider for symptoms of COPD or intensification of therapy \\[including second course of antibiotics for COPD, and second course of systemic steroids for COPD\\]) in the first 30 days after randomization.",
     "timeFrame": "Baseline to day 30 visit"
    },
    {
     "measure": "Health-related Quality of Life",
     "description": "St. George's Respiratory Questionnaire - Total Score\n\nThe SGRQ was asked with respect to the last one month as validated for acute exacerbations of COPD by Doll et al.\n\nScale from 0 (no disability) to 100 (maximum disability).\n\nThe SGRQ total score summarizes the impact of airway specific disease on overall health status. Scores range from zero (no impairment) to 100 (maximum impairment). Scores were calculated using the SGRQ scoring Algorithm.",
     "timeFrame": "Change from Baseline and 1 Month"
    },
    {
     "measure": "Change in Urinary Leukotriene (LTE4) Levels",
     "description": "Change in natural log-transformed LTE4 (ng/mg Cr.) from Baseline to 24 Hours",
     "timeFrame": "Baseline and 24 hours"
    },
    {
     "measure": "Change in Urinary Leukotriene (LTE4) Levels",
     "description": "Change in natural log-transformed LTE4 (ng/mg Cr.) from Baseline to 72 Hours",
     "timeFrame": "Baseline and 72 hours later"
    }
   ]
  },
  "eligibilityModule": {
   "eligibilityCriteria": "Inclusion Criteria:\n\n* Admitted to the hospital for a COPD exacerbation\n* FEV1 less than 60% of predicted level\n* At least 10 pack years of smoking\n\nExclusion Criteria:\n\n* Any uncontrolled systemic disease\n* Known hypersensitivity to zileuton\n* Asthma\n* Lobar pneumonia or pulmonary edema\n* Interstitial lung disease\n* Medical condition that is likely to limit survival to less than 30 days at the time of study entry\n* History of liver disease\n* Current use of theophylline\n* Participation in another clinical trial in the COPD Clinical Research Network\n* Incarceration\n* Institutionalization\n* Pregnant\n* History of a suicide attempt\n* Prior inpatient admission for a psychiatric disorder\n* Bipolar disorder\n\n'",
   "healthyVolunteers": false,
   "sex": "ALL",
   "minimumAge": "45 Years",
   "stdAges": [
    "ADULT",
    "OLDER_ADULT"
   ]
  },
