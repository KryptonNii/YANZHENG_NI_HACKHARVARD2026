 "resultsSection": {
  "participantFlowModule": {
   "preAssignmentDetails": "Eligible adult patients were enrolled by baseline post-bronchodilator FEV1/VC\\<70% and post bronchodilator FEV1 \\<60% predicted), greater than 10 pack years and sputum eosinophils greater than/equal to 3%.\n\nPatients were then randomized to either mepolizumab 750 mg every 4 weeks (Q4W) or matched placebo in a 1:1 ratio.",
   "recruitmentDetails": "Patients who met eligibility criteria after the screening visit entered a 24 week double-blind treatment period followed by one follow-up visit.",
