  "outcomesModule": {
   "primaryOutcomes": [
    {
     "measure": "Trough forced expiratory volume in one second (FEV1) response",
     "timeFrame": "12 Weeks, 24 Weeks and 48 Weeks"
    },
    {
     "measure": "FEV1 area under the curve (AUC) 0-8h response",
     "timeFrame": "12 Weeks, 24 Weeks and 48 Weeks"
    },
    {
     "measure": "Mahler Transition Dyspnoea Index (TDI) focal score",
     "timeFrame": "12 Weeks, 24 Weeks and 48 Weeks"
    },
    {
     "measure": "St George Respiratory Questionnaire (SGRQ) total score",
     "timeFrame": "12 Weeks, 24 Weeks and 48 Weeks"
    },
    {
     "measure": "Time to first moderate to severe COPD exacerbation",
     "timeFrame": "12 Weeks, 24 Weeks and 48 Weeks"
    }
   ],
   "secondaryOutcomes": [
    {
     "measure": "FEV1 AUC 0-8h response",
