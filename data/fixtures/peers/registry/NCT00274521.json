  "outcomesModule": {
   "primaryOutcomes": [
    {
     "measure": "The primary endpoint is the change in submaximal exercise tolerance (prior to treatment to after pulmonary rehabilitation) as measured by endurance time during a constant work rate treadmill exercise test at 80% of maximum work capacity",
     "timeFrame": "week 13"
    }
   ],
   "secondaryOutcomes": [
