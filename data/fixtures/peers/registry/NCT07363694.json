  "outcomesModule": {
   "primaryOutcomes": [
    {
     "measure": "Phase 2 part: Change from baseline in pre-bronchodilator Forced Expiratory Volume in 1 Second (FEV1) at Week 24",
     "description": "FEV1 is the maximal volume of air exhaled in the first second of a forced expiration from a position of full inspiration. FEV1 is obtained from spirometry.",
     "timeFrame": "Baseline to Week 24"
    },
    {
     "measure": "Phase 3 part: Annualized rate of moderate or severe ECOPD",
     "description": "Exacerbation of Chronic Obstructive Pulmonary Disease (ECOPD) are sudden worsening of respiratory symptoms that significantly worsen lung function and quality of life.",
     "timeFrame": "Baseline to Week 52"
    }
