     "type": "DRUG",
     "name": "Ipratropium bromide 18 mcg and albuterol sulfate 103 mcg"
    }
   ]
  },
  "outcomesModule": {
   "primaryOutcomes": [
    {
     "measure": "Lung function after 2 weeks of treatment"
    }
   ],
   "secondaryOutcomes": [
    {
     "measure": "Lung function at each time point, patient questionnaires, medication compliance,"
    },
    {
     "measure": "adverse events, clinical labs, vital signs, ECGs, physical exams"
    }
   ]
  },
  "eligibilityModule": {
   "eligibilityCriteria": "Inclusion Criteria:\n\n* Diagnosis of COPD\n* Smoker or exsmoker with at least 10 years smoking at least one pack of cigarettes per day\n* Meet lung function requirements\n\nExclusion Criteria:\n\n* Diagnosis of Asthma\n* Significant disease other than COPD\n* Female pregnant or lactating or planning to become pregnant",
   "healthyVolunteers": false,
   "sex": "ALL",
   "minimumAge": "40 Years",
