  "outcomesModule": {
   "primaryOutcomes": [
    {
     "measure": "Difference in efficacy of a 12 months treatment with salmeterol/fluticasone combination versus fluticasone on lung function (FEV1) as percentage predicted."
    }
   ],
   "secondaryOutcomes": [
    {
     "measure": "Reversibility of lung function with salbutamol and on Forced Vital capacity (FVC), TLC, FRC, FVC, Inspiration capacity(IC), Forced Inspiratory Volume in 1 second (FIV1) and Maximum mid-Expiratory Flow (MEF50)."
    }
   ]
  },
  "eligibilityModule": {
   "eligibilityCriteria": "Inclusion criteria:\n\n* Established history of chronic obstructive pulmonary disease (COPD).\n* Lung function parameters: FEV1/FVC ratio \\< 70%, FEV1 between 80% and 30% predicted, a reversibility of airway obstruction of 12% of the initial value with a minimum of 200 mL.\n* Signed and dated informed consent.\n\nExclusion criteria:\n\n* History of asthma or allergy.\n* Unstable COPD in the 3 months before the study.\n* Interference of non-pulmonary medication or diseases with COPD outcome parameters.",
   "healthyVolunteers": false,
