   "primaryOutcomes": [
    {
     "measure": "Adverse event rate",
     "description": "The occurrence of all adverse events (AEs), serious adverse events (SAEs) and treatment-related adverse events (TEAEs).",
     "timeFrame": "Queue A: Extended study period: Weeks 24-50; Queue B: At week 12 of treatment"
    },
    {
     "measure": "Number of subjects with laboratory abnormalities",
     "description": "Number of subjects with laboratory tests showing abnormal results",
     "timeFrame": "Queue A: Extended study period: Weeks 24-50; Queue B: At week 12 of treatment"
    },
    {
