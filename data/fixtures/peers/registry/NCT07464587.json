     "description": "Annualized rate of moderate or severe Obstructive Chronic Pulmonary Disease (COPD) acute exacerbations over 48 weeks of treatment (compared according to the treatment groups in the TQC3721-III-01 study).",
     "timeFrame": "Up to 48 weeks"
    },
    {
     "measure": "On-treatment time to first moderate or severe exacerbation",
     "description": "Time to first moderate or severe COPD exacerbation over the 48-week treatment period (To be compared according to the randomized treatment groups assigned in the TQC3721-III-01 study).",
     "timeFrame": "Up to 48 weeks"
    },
    {
     "measure": "Change from baseline in trough Forced Expiratory Volume in 1 second (FEV₁)",
     "description": "Analysis of change from baseline in trough FEV₁ at weeks 32, 40, and 48 of treatment (Baseline is defined as the corresponding value from the TQC3721-III-01 study; comparisons will be performed according to the randomized treatment groups assigned in that study).",
     "timeFrame": "At weeks 32, 40, and 48 of treatment"
    }
   ]
