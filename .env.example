# Copy to .env and fill in locally. Never commit .env.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
EXTRACT_MODEL=claude-sonnet-5-5
DEMO_OFFLINE=0
TP_SECRET_PEPPER=
# Optional output directory containing package/package_index.json. If unset, the API
# reads validation/out/served_output.txt, then falls back to validation/out.
# Never point validation tests at an existing user's database.
TP_VALIDATION_OUT=
